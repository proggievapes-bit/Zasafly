PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zasafly

# Set these before first startup to create/update the admin account.
ADMIN_NAME=ZasaFly Admin
ADMIN_EMAIL=admin@zasafly.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# --- Cloud database (e.g. Aiven free MySQL). Leave DB_CA empty for local XAMPP. ---
# DB_HOST=your-service.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your-password
# DB_NAME=defaultdb
# Paste the provider's CA certificate (PEM). Multi-line is fine on Render's dashboard.
# DB_CA=
